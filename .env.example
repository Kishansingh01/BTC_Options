# Bybit API Credentials (Testnet or Mainnet)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Alternatively, set testnet specific env variables:
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Environment options: TESTNET, DEMO, MAINNET
BYBIT_ENVIRONMENT=TESTNET

# Trading configuration
UNDERLYING_SYMBOL=BTCUSDT
CONTRACT_QTY=0.01
USE_RISK_MANAGEMENT=true
STOP_LOSS_PCT=0.01
TAKE_PROFIT_PCT=0.02

